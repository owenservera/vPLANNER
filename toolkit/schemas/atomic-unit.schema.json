{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forge.local/schemas/atomic-unit.schema.json",
  "title": "AtomicUnit",
  "description": "The canonical dispatch record every FORGE primitive compiles down to. This is the object handed to any orchestrator (Claude Code subagents, custom swarm, CI). See 00-CORE/00_DESIGN.md section 3.",
  "type": "object",
  "required": [
    "unit_id", "primitive_type", "title", "status", "default_tier",
    "dependencies", "acceptance_test"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "pattern": "^(WORK|DEP|ASM|CON|IFACE|SKILL|DOR|CKPT|BUD|ESC|RBK|WS|PH|MS|RSK|DCL)-[0-9]{4,}$",
      "description": "Prefixed, zero-padded ID. Prefix determines primitive_type."
    },
    "primitive_type": {
      "type": "string",
      "enum": [
        "backlog_item", "dependency_edge", "assumption", "constraint",
        "interface_contract", "skill_requirement", "definition_of_ready",
        "checkpoint", "budget_line", "escalation_record", "rollback_point",
        "workstream", "phase", "milestone", "risk", "decision"
      ]
    },
    "title": { "type": "string", "minLength": 3 },
    "workstream": { "type": "string", "pattern": "^WS-[0-9]{2,}$" },
    "phase": { "type": "string", "pattern": "^PH-[0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["PENDING", "READY", "IN_PROGRESS", "BLOCKED", "REVIEW", "COMPLETE", "FAILED", "PARKED"]
    },
    "default_tier": { "$ref": "model-tier.schema.json" },
    "stage_tiers": {
      "type": "array",
      "description": "Optional per-stage tier overrides for multi-stage units. If absent, default_tier applies to the whole unit.",
      "items": {
        "type": "object",
        "required": ["stage", "tier"],
        "properties": {
          "stage": { "type": "string" },
          "tier": { "$ref": "model-tier.schema.json" }
        }
      }
    },
    "escalation_triggers": {
      "type": "array",
      "description": "Deterministic conditions (see 00_DESIGN.md 4.2) that auto-escalate this unit one tier if true at dispatch time.",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "description": "List of DEP- edge IDs. The edges themselves (not this list) carry type/hard/reason.",
      "items": { "type": "string", "pattern": "^DEP-[0-9]{4,}$" }
    },
    "skill_requirements": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SKILL-[0-9]{4,}$" }
    },
    "definition_of_ready": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DOR-.+$" }
    },
    "acceptance_test": {
      "type": "string",
      "minLength": 5,
      "description": "Human-and-machine-checkable statement of done. No unit may enter COMPLETE without this being satisfiable."
    },
    "budget": {
      "type": "object",
      "properties": {
        "line": { "type": "string", "pattern": "^BUD-.+$" },
        "est_tokens": { "type": "integer", "minimum": 0 },
        "actual_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "File paths or artifact IDs produced by this unit once COMPLETE."
    },
    "provenance": {
      "type": "array",
      "items": { "type": "string" },
      "description": "SRC-ID | artifact | sha256 | anchor lines, or DCL-xxx | date, per v1 provenance convention."
    },
    "checkpoint": {
      "type": ["string", "null"],
      "pattern": "^(CKPT-[0-9]{4,}|null)$"
    },
    "rollback_point": {
      "type": ["string", "null"],
      "pattern": "^(RBK-[0-9]{4,}|null)$"
    },
    "retry_count": { "type": "integer", "minimum": 0, "default": 0 },
    "assigned_model": {
      "type": ["string", "null"],
      "description": "Resolved by model_router.py at dispatch time. Null until dispatched."
    }
  }
}
